APP_ENV=local
DATA_PACKAGE_DIR=示范景区公开资料包
DATABASE_PATH=backend/storage/lingjing.db
STORAGE_DIR=backend/storage
VECTOR_BACKEND=chroma

# 阿里云百炼 / Qwen OpenAI 兼容接口
QWEN_API_KEY=your_dashscope_or_bailian_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-omni-plus-2026-03-15

# 语音适配层：ASR_PROVIDER 支持 funasr、sherpa_onnx、vivo、mock
# TTS_PROVIDER 支持 cosyvoice、piper、sherpa_onnx、vivo、mock
ASR_PROVIDER=funasr
TTS_PROVIDER=edge

# FunASR：可填本地服务地址，或本地模型目录
FUNASR_BASE_URL=
FUNASR_ASR_PATH=/api/asr
FUNASR_MODEL_DIR=

# CosyVoice：推荐本地轻量服务，返回 audio_url 或 audio_base64
COSYVOICE_BASE_URL=
COSYVOICE_TTS_PATH=/api/tts
COSYVOICE_MODEL_DIR=

# sherpa-onnx：普通 Windows 电脑离线保底入口
SHERPA_ONNX_ASR_BASE_URL=
SHERPA_ONNX_ASR_PATH=/api/asr
SHERPA_ONNX_ASR_EXE=
SHERPA_ONNX_ASR_MODEL_DIR=
SHERPA_ONNX_ASR_EXTRA_ARGS=
SHERPA_ONNX_ASR_COMMAND=
SHERPA_ONNX_TTS_BASE_URL=
SHERPA_ONNX_TTS_PATH=/api/tts
SHERPA_ONNX_TTS_EXE=
SHERPA_ONNX_TTS_MODEL_DIR=
SHERPA_ONNX_TTS_EXTRA_ARGS=
SHERPA_ONNX_TTS_COMMAND=

# Piper：Windows 离线 TTS 保底入口
PIPER_EXE=
PIPER_MODEL=
PIPER_CONFIG=
MOCK_ASR_TEXT=九龙灌浴表演时间是什么？

# Vivo 实时短语音识别与 TTS，可通过 ASR_PROVIDER/TTS_PROVIDER 切换启用
VIVO_APP_ID=your_vivo_app_id
VIVO_APP_KEY=your_vivo_app_key
VIVO_ASR_URL=ws://api-ai.vivo.com.cn/asr/v2
VIVO_ASR_ENGINE_ID=shortasrinput
VIVO_TTS_URL=wss://api-ai.vivo.com.cn/tts
VIVO_TTS_ENGINE_ID=short_audio_synthesis_jovi
VIVO_TTS_VOICE=yige

# OpenTalking 官方 session + WebRTC 主链路（本机 RTX 4060 8GB）
# 继续使用本项目的 Qwen、知识库与 Vivo TTS；合成后的音频上传到 session 直驱口型。
OPENTALKING_SESSION_ENABLED=1
OPENTALKING_SESSION_AUTOSTART=1
OPENTALKING_SESSION_BASE_URL=http://127.0.0.1:8210
OPENTALKING_SESSION_MODEL=quicktalk
OPENTALKING_SESSION_AVATAR_ID=lingjing-guide-quicktalk
OPENTALKING_SESSION_PYTHON=third_party/opentalking/.venv/Scripts/python.exe
OPENTALKING_SESSION_TIMEOUT_SECONDS=45
OPENTALKING_SESSION_STT_PROVIDER=funasr
OPENTALKING_SESSION_TTS_PROVIDER=edge
OPENTALKING_SESSION_AVATARS_DIR=backend/storage/opentalking-avatar
OPENTALKING_PREWARM_AVATARS=lingjing-guide-quicktalk
OPENTALKING_PREWARM_MODEL=quicktalk
OPENTALKING_QUICKTALK_SLICE_LEN=28
OPENTALKING_QUICKTALK_RENDER_CHUNK_MS=500
OPENTALKING_QUICKTALK_PREFETCH=1
OPENTALKING_QUICKTALK_WORKER_CACHE=1

# 远程高质量驱动扩展位；未来可配置 FlashTalk / FlashHead 服务。
OPENTALKING_REMOTE_PROVIDER_BASE_URL=
OPENTALKING_REMOTE_PROVIDER_MODEL=flashtalk

# 兼容兜底：旧整段 MP4 口型桥接。session 不可用时才尝试，不作为实时主链路。
OPENTALKING_BASE_URL=
OPENTALKING_LIPSYNC_PATH=/api/lipsync
OPENTALKING_RESULT_PATH=/api/lipsync/{task_id}
OPENTALKING_HEALTH_PATH=/api/health
OPENTALKING_MODEL=quicktalk
OPENTALKING_AVATAR_ID=lingjing-guide
OPENTALKING_AVATAR_IMAGE=public/assets/generated/avatar-guide.png
OPENTALKING_AVATAR_DIR=backend/storage/opentalking-avatar/lingjing-guide-quicktalk
OPENTALKING_TIMEOUT_SECONDS=240
OPENTALKING_POLL_SECONDS=1.2
OPENTALKING_AUTOSTART=0
OPENTALKING_PYTHON=
# 可选：演示现场预生成真实口型片段；只在请求 allow_demo 或 OPENTALKING_DEMO_FALLBACK=1 时启用
OPENTALKING_DEMO_VIDEO=
OPENTALKING_DEMO_LABEL=预生成真实口型片段
OPENTALKING_DEMO_FALLBACK=0
OPENTALKING_INFER_TIMEOUT=300
OPENTALKING_BRIDGE_RENDER_MODE=persistent
OPENTALKING_WARMUP=1
OPENTALKING_QUICKTALK_DEVICE=cuda:0
OPENTALKING_QUICKTALK_HUBERT_DEVICE=cuda:0
OPENTALKING_QUICKTALK_ASSET_ROOT=models/quicktalk
OPENTALKING_QUICKTALK_FPS=25
OPENTALKING_QUICKTALK_MAX_SECONDS=0
OPENTALKING_QUICKTALK_MAX_TEMPLATE_SECONDS=2.4
# 旧 MP4 兜底也维持 720p 高质量；实时响应由上面的 WebRTC 链路承担。
OPENTALKING_QUICKTALK_OUTPUT_MAX_SIDE=720
OPENTALKING_QUICKTALK_X264_PRESET=fast
OPENTALKING_QUICKTALK_X264_CRF=18
OPENTALKING_WAV2LIP_DEVICE=cuda
OPENTALKING_WAV2LIP_FACE_DET_DEVICE=cuda
OPENTALKING_WAV2LIP_MODEL_ROOT=models/wav2lip
OPENTALKING_WAV2LIP_MAX_SECONDS=0
# 本地桥接服务使用：命令应生成 {output} 指定的视频文件
OPENTALKING_INFER_COMMAND={pythonq} ..\..\scripts\opentalking_quicktalk_gpu_render.py --avatar-dir "{avatar}" --audio "{audio}" --output "{output}" --device cuda:0
OPENTALKING_WORKDIR=third_party/opentalking
OPENTALKING_OUTPUT_DIR=backend/storage/opentalking-output

# 如 Vivo 账号支持多个发音人，可为前台 6 个音色分别配置真实 voice code
VIVO_TTS_VOICE_GENTLE=xiaofu
VIVO_TTS_VOICE_CALM=x2_yunye_news
VIVO_TTS_VOICE_BRIGHT=yige
VIVO_TTS_VOICE_STORY=F245_natural
VIVO_TTS_VOICE_CHILD=yige_child
VIVO_TTS_VOICE_BROADCAST=GAME_GIR_LTY
VIVO_TTS_ENGINE_GENTLE=short_audio_synthesis_jovi
VIVO_TTS_ENGINE_CALM=long_audio_synthesis_screen
VIVO_TTS_ENGINE_BRIGHT=short_audio_synthesis_jovi
VIVO_TTS_ENGINE_STORY=tts_humanoid_lam
VIVO_TTS_ENGINE_CHILD=short_audio_synthesis_jovi
VIVO_TTS_ENGINE_BROADCAST=tts_humanoid_lam
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=
